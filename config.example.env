# claude-voice configuration.
# Copy to config.env and fill in. config.env is gitignored.
#
# This file holds *pointers* to secrets, never the secrets themselves.

# --- Sink: Telegram ---------------------------------------------------------
# File containing `token=<bot token>` (from @BotFather).
CLAUDE_VOICE_TELEGRAM_ENV=/path/to/secrets/telegram.env
# Your chat with the bot. Run bin/find-chat-id.sh to discover it.
CLAUDE_VOICE_TELEGRAM_CHAT_ID=

# --- Synthesize: TTS driver -------------------------------------------------
# Name of an executable under tts/ implementing the driver contract:
#   text on stdin -> MP3 bytes on stdout
CLAUDE_VOICE_TTS_DRIVER=gcp
CLAUDE_VOICE_TTS_VOICE=ko-KR-Chirp3-HD-Aoede
# Speaking rate. 1.0 is the engine default and runs slow for background
# listening; 1.25-1.4 is easier to let wash over you while working.
CLAUDE_VOICE_TTS_RATE=1.3
CLAUDE_VOICE_GCP_KEY=/srv/service-account.json
CLAUDE_VOICE_GCP_PROJECT=your-gcp-project

# --- Render: summarizer -----------------------------------------------------
# Model alias passed to `claude -p`.
CLAUDE_VOICE_MODEL=haiku

# --- Policy -----------------------------------------------------------------
# Turns shorter than this many characters are not worth speaking.
CLAUDE_VOICE_MIN_CHARS=120
# Hard cap on what we hand the summarizer, to bound cost on huge turns.
CLAUDE_VOICE_MAX_CHARS=12000

# --- Runtime ----------------------------------------------------------------
# Scratch dir for audio, logs, and the isolated gcloud config.
CLAUDE_VOICE_STATE=/opt/claude-voice/state
