# claude-voice configuration.
# Copy to config.env and fill in. config.env is gitignored.
#
# This file holds *pointers* to secrets, never the secrets themselves.

# --- Sink: Telegram ---------------------------------------------------------
# File containing `token=<bot token>` (from @BotFather).
CLAUDE_VOICE_TELEGRAM_ENV=/path/to/secrets/telegram.env
# Your chat with the bot. Run bin/find-chat-id.sh to discover it.
CLAUDE_VOICE_TELEGRAM_CHAT_ID=

# text  — plain message. iOS "Announce Notifications" reads it over AirPods
#         with no tap, but in Siri's voice. This is the hands-free option.
# voice — synthesized voice note. Our voice and Telegram's speed control,
#         but you have to tap to play it.
# both  — send both, and decide after a week of listening.
CLAUDE_VOICE_DELIVER_MODE=both

# --- Synthesize: TTS driver -------------------------------------------------
# Name of an executable under tts/ implementing the driver contract:
#   text on stdin -> MP3 bytes on stdout
CLAUDE_VOICE_TTS_DRIVER=gcp
CLAUDE_VOICE_TTS_VOICE=ko-KR-Chirp3-HD-Aoede
# Speaking rate. 1.0 is the engine default and runs slow for background
# listening; 1.25-1.4 is easier to let wash over you while working.
CLAUDE_VOICE_TTS_RATE=1.3
CLAUDE_VOICE_GCP_KEY=/srv/service-account.json
CLAUDE_VOICE_GCP_PROJECT=your-gcp-project

# --- Render: summarizer -----------------------------------------------------
# Name of an executable under llm/ implementing the driver contract:
#   prompt on stdin -> summary text on stdout
#
# claude   — rides the machine's Claude subscription, no API key needed, but
#            carries ~30k tokens of harness context on every call.
# deepseek — a plain API call, so far cheaper per turn; needs a key.
CLAUDE_VOICE_LLM_DRIVER=claude
# Used only if the primary driver fails. Worth setting when the primary is a
# hosted API — leave empty to let a failed turn stay silent.
CLAUDE_VOICE_LLM_FALLBACK=

# claude driver: model alias passed to `claude -p`.
CLAUDE_VOICE_MODEL=haiku

# deepseek driver: read the key from wherever it already lives rather than
# copying it here. an existing deployment stores it as `provider|model|key`.
CLAUDE_VOICE_DEEPSEEK_ENV=/path/to/secrets/docker-compose.yml
CLAUDE_VOICE_DEEPSEEK_VAR=DEEPSEEK_API_KEY
# Optional overrides — set CLAUDE_VOICE_DEEPSEEK_KEY to bypass the file entirely.
#CLAUDE_VOICE_DEEPSEEK_MODEL=deepseek-chat
#CLAUDE_VOICE_DEEPSEEK_KEY=

# --- Policy -----------------------------------------------------------------
# Turns shorter than this many characters are not worth speaking.
CLAUDE_VOICE_MIN_CHARS=120
# Hard cap on what we hand the summarizer, to bound cost on huge turns.
CLAUDE_VOICE_MAX_CHARS=12000

# --- Inbound: spoken replies ------------------------------------------------
# Executable under stt/ implementing: OGG/Opus on stdin -> transcript on stdout
CLAUDE_VOICE_STT_DRIVER=gcp
CLAUDE_VOICE_STT_LANGUAGE=ko-KR

# Model that handles a spoken reply. This one answers you directly, so it is
# worth more than the summarizer.
CLAUDE_VOICE_REPLY_MODEL=sonnet

# Tools a spoken reply may NOT use. A transcribed instruction is acted on with
# nobody watching and no way to answer a confirmation prompt, so the default
# keeps replies read-only. Empty this to let replies change files.
CLAUDE_VOICE_REPLY_DISALLOWED=Edit Write Bash NotebookEdit

# --- Runtime ----------------------------------------------------------------
# Scratch dir for audio, logs, and the isolated gcloud config.
CLAUDE_VOICE_STATE=/opt/claude-voice/state
